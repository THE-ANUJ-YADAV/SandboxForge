FROM node:20-bullseye

# Install the native build tools required by node-pty
RUN apt-get update && apt-get install -y \
    make \
    g++ \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

EXPOSE 3000

RUN mkdir /workspace

CMD ["node","server.js"]